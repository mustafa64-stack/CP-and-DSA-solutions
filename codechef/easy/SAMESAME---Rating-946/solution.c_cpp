#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int m,n;
        cin>>m>>n;
        string s,s1;
        cin>>s>>s1;
        int minn=101;
        int c=0;
        for(int i=0;i<=s.size()-s1.size();i++){
            c=0;
            for(int j=0;j<s1.size();j++){
                if(s1[j]!=s[i+j]){
                    c++;
                }
            }minn=min(c,minn);
        }cout<<minn<<endl;
    }
}
