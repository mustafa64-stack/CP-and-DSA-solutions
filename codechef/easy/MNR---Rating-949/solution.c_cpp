#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        long long n;
        cin>>n;
        vector<long long> a(n);
        for(int i=0;i<n;i++){
            cin>>a[i];
        }
        sort(a.begin(),a.end());
        long long op1=a[n-1]-a[2];
        long long op2=a[n-2]-a[1];
        long long op3=a[n-3]-a[0];
        cout<<min({op1,op2,op3})<<"\n";
    }
}
