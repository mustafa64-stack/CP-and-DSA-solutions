#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n,k;
        int c=0;
        cin>>n>>k;
        vector <int> h(n);
        for(int i=0;i<n;i++){
            cin>>h[i];
            if(h[i]>k) c++;
        }cout<<c<<endl;
    }
}
