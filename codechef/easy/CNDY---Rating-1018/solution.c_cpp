#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<long long> a(2*n);
        for(int i=0;i<2*n;i++){
            cin>>a[i];
        }int flag=0;
        sort(a.begin(),a.end());
        for(int i=0;i<(2*n)-2;i++){
            if(a[i]==a[i+1] &&a[i+1]==a[i+2]){
                flag=1;
                break;
            }
        }if(flag) cout<<"no";
        else cout<<"yes";
        cout<<'\n';
    }
}
