#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n,x;
        cin>>n>>x;
        double s=0,r=0;
       
        for(int i=1;i<=n-x;i++){
            s+=pow(2,i);
        }
        for(int i=n;i>n-x;i--){
            r+=pow(2,i);
        }cout<<r-s<<endl;
    }
}
