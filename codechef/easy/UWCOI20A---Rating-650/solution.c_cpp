#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        long long n,a;
        cin>>n;
        long long maxx=-1e9;
        for(int i=0;i<n;i++){
            cin>>a;
            maxx=max(a,maxx);
        }cout<<maxx<<"\n";
    }
}
