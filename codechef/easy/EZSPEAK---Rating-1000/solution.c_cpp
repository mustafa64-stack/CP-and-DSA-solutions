#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        string s;
        cin>>s;
        int c=0;
        int maxc=0;
        for(int i=0;i<n;i++){
            if(s[i]!='a' &&s[i]!='e' &&s[i]!='i' &&s[i]!='o' &&s[i]!='u' ) c++;
            else {maxc=max(c,maxc);
                c=0;}
            
        }maxc=max(c,maxc);if(maxc>=4) cout<<"no"<<endl;
        else cout<<"yes"<<endl;
    }
}
