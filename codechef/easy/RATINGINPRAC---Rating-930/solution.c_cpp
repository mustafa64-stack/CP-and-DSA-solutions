#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int d[n];
        for(int i=0;i<n;i++){
            cin>>d[i];
        }
        int flag=0,i=0;
        for(i=0;i<n-1;i++){
            if(d[i]>d[i+1]) {
                flag=1;
                break;
            }
        }
        if (flag) cout<<"no";
        else cout<<"yes";
        cout<<"\n";
        // your code goes here
    }

}
