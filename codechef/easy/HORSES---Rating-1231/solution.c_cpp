#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        long long s[n];
        for(int i=0;i<n;i++){
            cin>>s[i];
        }
        // your code goes here
        sort(s,s+n);
        long long minn=1e10+1;
        for(int i=0;i<n-1;i++){
            minn=min(minn,abs(s[i]-s[i+1]));
        }cout<<minn<<endl;
    }

}
