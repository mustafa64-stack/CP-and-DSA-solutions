#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n,m;
        cin>>n>>m;
        string sa,sb;
        cin>>sa>>sb;
        int count=0;
        bool v[26]={false};
        for(char c:sa) v[c-'a']=true;
        for(char c:sb) v[c-'a']=true;
        for(bool i:v){
            if(i==true) count++;
            
        }
        if(count<26) cout<<"yes"<<endl;
        else cout<<"no"<<endl;
    }
}
