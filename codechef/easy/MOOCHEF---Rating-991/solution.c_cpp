#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n,l,r;
        cin>>n>>l>>r;
        vector <int> a(n);
        int maxx=0,h=0,minn=2*1e5+1;
        
        for(int i=0;i<n;i++){
            cin>>a[i];
            if(a[i]>=l && a[i]<=r) h++;
            else h--;
            maxx=max(maxx,h);
            minn=min(minn,h);
        }cout<<maxx<<" "<<minn<<endl;
        
    }
}
