#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n,k;
        cin>>n>>k;
        int c=0;
        string s;
        cin>>s;
        for(int i=s.size();i>=0;i--){
            if(k>0){
                if(s[i]=='1' &&s[i-1]=='0'){
                    s[i-1]='1';
                    k--;
                }
            }
        }for(int i=s.size();i>=0;i--){
            if(s[i]=='1'){
                c++;
            }
        }cout<<c<<endl;
    }
}
