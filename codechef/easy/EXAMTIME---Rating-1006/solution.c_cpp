#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int d1,d2,d3,s1,s2,s3;
        cin>>d1>>d2>>d3>>s1>>s2>>s3;
        int sd=d1+d2+d3,ss=s1+s2+s3;
        pair<int,pair<int,int>> p1={sd,{d1,d2}};
        pair<int,pair<int,int>> p2={ss,{s1,s2}};
        if(p1>p2) cout<<"dragon"<<endl;
        else if(p2>p1) cout<<"sloth"<<endl;
        else cout<<"tie"<<endl;
    }
}
