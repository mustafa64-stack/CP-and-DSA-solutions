#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int a[n];
        for(int i=0;i<n;i++){
            cin>>a[i];
        }
        // your code goes here
        sort(a,a+n);
        int i=n-1;
        while(a[i]==a[i-1]){
            i--;
        }
        cout<<a[i]+a[i-1]<<endl;
    }
}
