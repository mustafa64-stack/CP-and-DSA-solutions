#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        long long minn=1e9;
        long long n,k,flag=0;
        cin>>n>>k;
        vector <long long> a(n);
        for(int i=0;i<n;i++){
            cin>>a[i];
            if(a[i]>=k) flag=1;
            minn=min(minn,a[i]%k);
        }if (flag) cout<<minn<<endl;
        else cout<<-1<<endl;
    }
}
