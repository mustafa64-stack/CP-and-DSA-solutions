#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector <int> a(2*n);
        for(int i=0;i<2*n;i++) cin>>a[i];
        for(int i=0;i<n;i++) {
            if(a[i]<a[2*n-i-1]) a[i]=a[2*n-i-1];
        }int ss=0;
        for(int i=0;i<n;i++) ss+=a[i];
        cout<<ss<<endl;
        
    }
}
