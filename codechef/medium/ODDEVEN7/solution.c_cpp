#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int> a(n);
        for(int i=0;i<n;i++) {
            cin>>a[i];
        }
        int ne=0,no=0;
        for(int i=0;i<n;i++) {
            if(a[i]%2==0) ne++;
            else no++;
        }int o=min(ne,no);
        if(2*o+1<n)
        cout<<2*o+1<<endl;
        else cout<<o+max(ne,no)<<endl;
    }
}
