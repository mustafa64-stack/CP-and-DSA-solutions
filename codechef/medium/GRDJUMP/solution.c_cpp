#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int a,b,p,q,r;
        cin>>a>>b>>p>>q>>r;
        int m=0,n=0,c=0;
        while(m!=a &&n!=b){
            if((m-a)==(n-b) && m-a>1) {c+=max(2*r,p+q);
                m+=2;
                n+=2;
            } else if((m-a)==(n-b) && (m-a)==1){
                c+=max(r,p+q);
                m+=1;
                n+=1;
            }else if(((a-m)-(b-n))>1 ) {
                c+=p;
                m+=2;
            }else if(((a-m)-(b-n))==1 ) {
                c+=p;
                m+=1;
            }else if(((b-n)-(a-m))>1 ){
                c+=q;
                n+=2;
            }else if(((b-n)-(a-m))==1 ){
                c+=q;
                n+=1;
            }
        }cout<<c<<endl;
}
}
