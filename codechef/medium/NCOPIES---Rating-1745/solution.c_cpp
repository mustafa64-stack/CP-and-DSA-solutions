#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n,m;
        cin>>n>>m;
        string s;
        cin>>s;
        int c=0;
        int sum=0;
        for(int i=0;i<n;i++){
            if(s[i]=='1') c++;
            else sum++;
            
        }
        if(c==0){
            cout<<n*m<<endl;
        }else {
            cout<<1+sum<<endl;
        }
    }
}
