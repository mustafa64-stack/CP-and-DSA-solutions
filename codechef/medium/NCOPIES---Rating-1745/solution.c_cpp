#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n,m;
        cin>>n>>m;
        int sum=0;
        string s;
        cin>>s;
        for(int i=0;i<n;i++){
            sum+=s[i]-'0';
        }
        if(sum==0){
            cout<<n*m<<"\n";
        }else if(n*m%2==0){
            cout<<1<<endl;
        }else cout<<2<<endl;
    }
}
