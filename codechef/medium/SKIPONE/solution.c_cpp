#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        long long k;
        long long n,o=0,maxx=0,d=1,m=1;
        cin>>n>>k;
        vector <long long> a(n);
        for(int i=0;i<n;i++) {
            cin>>a[i];
            
            }for(int i=0;i<n;i++) {
                maxx=max(maxx,a[i]);
            if(k>=a[i] ){
                k-=a[i];
                o++;
            }else if(d!=0 && a[i]<=k+maxx ){ 
                k = k + maxx - a[i];
                o++;
            d--;
                
            }else break;
        }cout<<o<<endl;
        
    }
}
