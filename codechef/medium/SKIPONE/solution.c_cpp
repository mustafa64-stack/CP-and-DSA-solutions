#include <bits/stdc++.h>
using namespace std;
#define int long long
int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n,k,lf=0;
        cin>>n>>k;
        vector <int> a(n);
        for(int i=0;i<n;i++) {cin>>a[i];
        if(lf<=k)
            lf+=a[i];
        }
    }
}
