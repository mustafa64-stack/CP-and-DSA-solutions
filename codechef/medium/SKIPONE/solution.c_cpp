#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        long long k;
        int n,o=0,maxx=0;
        cin>>n>>k;
        vector <int> a(n);
        for(int i=0;i<n;i++) {cin>>a[i];
        }
        for(int i=0;i<n;i++) {
        
            
            maxx=max(a[i],maxx);
            
        }k+=maxx;
        for(int i=0;i<n;i++) {
        if(maxx==a[i]) break;
        if(k>=0) {
            if(k>=a[i]) {o++;
            k-=a[i];
            
            }
        }
        }
        k+=maxx;
        cout<<o+1<<endl;
        
        
        
    }
}
