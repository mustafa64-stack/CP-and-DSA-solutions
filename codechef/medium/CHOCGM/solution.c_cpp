#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int sum=0;
        int b=0,al=0;
        vector<int> a(n);
        for(int i=0;i<n;i++){
            cin>>a[i];
            sum+=a[i];
            if(sum%2==0){
                al+=a[i];
            }else b+=a[i];
        }cout<<al<<endl;
        
    }
}
